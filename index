function F.inferItemKind(record)
	local known = KNOWN_CATALOG_KINDS[normalise(record.image)]
	if known then return known end
	local name = normalise(record.name)
	if name:find("knife", 1, true) then return "knife" end
	if name:find("gun", 1, true) or name:find("pistol", 1, true) then return "gun" end
	local media = normalise(table.concat({
		record.image or "", record.wiki or "", record.slug or "",
	}, " "))
	if media:find("knife", 1, true) or media:find("blade", 1, true)
		or media:find("dagger", 1, true) then return "knife" end
	if media:find("gun", 1, true) or media:find("pistol", 1, true)
		or media:find("revolver", 1, true) then return "gun" end
	if normalise(record.category) == "pets" then return "pet" end
	return nil
end

for _, records in pairs(valuesByName) do
