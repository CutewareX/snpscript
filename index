	if os.clock() < nextInventorySearch then return nil end
	nextInventorySearch = os.clock() + 0.5
	for _, gui in ipairs(playerGui:GetChildren()) do
		if gui:IsA("ScreenGui") and gui.Enabled and gui.Name ~= "Scoreboard" and gui.Name ~= "CameraFade" and gui.Name ~= "SpawnFade" then
