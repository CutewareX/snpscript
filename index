function F.addCatalogRecord(index, record)
	record.nameKey = normalise(record.name)
	record.categoryKey = normalise(record.category)
	record.kind = F.inferItemKind(record)
	record.tokens = {}
	for _, value in ipairs({ record.id, record.slug, record.image, record.wiki }) do
		local token = normalise(value)
		if #token >= 4 then table.insert(record.tokens, token) end
		local tail = tostring(value or ""):match("([^/]+)$")
		tail = normalise(tail)
		if #tail >= 4 and tail ~= token then table.insert(record.tokens, tail) end
		local stem = tostring(value or ""):match("([^/]+)%.[^%.]+$")
		stem = normalise(stem)
		if #stem >= 4 and stem ~= tail and stem ~= token then
			table.insert(record.tokens, stem)
		end
	end

	local aliases = { record.nameKey }
	local baseName = tostring(record.nameKey)
	baseName = baseName:gsub("20%d%d$", ""):gsub("19%d%d$", ""):gsub("%d%d$", "")
	baseName = baseName:gsub("gun$", ""):gsub("knife$", "")
	baseName = baseName:gsub("weapon$", "")
	if #baseName >= 2 and baseName ~= record.nameKey then
		table.insert(aliases, baseName)
	end
	for _, alias in ipairs(record.aliases or {}) do
		alias = normalise(alias)
		if #alias >= 2 then table.insert(aliases, alias) end
	end
	for _, alias in ipairs(aliases) do
		index[alias] = index[alias] or {}
		table.insert(index[alias], record)
	end
end

function F.mergeFallbackCatalog(index)
	local primaryKeys = {}
	for key in pairs(index) do primaryKeys[key] = true end
	local ok, response = pcall(requestFn, {
		Url = CONFIG.FALLBACK_CATALOG_URL,
		Method = "GET",
		Timeout = CONFIG.HTTP_TIMEOUT_SECONDS,
	})
	if not ok or not response or (response.Success ~= nil and not response.Success) then
		return 0, false
	end
	local body = response.Body or response.body
	if type(body) ~= "string" or #body < 10000 then return 0, false end

	local parsed, added = 0, 0
	local pattern = [[onclick="addItem%(%s*'([^']+)'%s*,%s*([%d%.]+)%s*,%s*'([^']*)'%s*,%s*'(.-)'%)"><img%s+src="([^"]+)"]]
	for id, value, cssClass, sourceName, image in body:gmatch(pattern) do
		parsed = parsed + 1
		sourceName = sourceName:gsub("\\'", "'")
			:gsub("&amp;", "&"):gsub("&lt;", "<"):gsub("&gt;", ">")
		local displayName = sourceName:gsub("%s*%([Gg]un%)$", "")
			:gsub("%s*%([Kk]nife%)$", "")
		if displayName == "Checkers" then displayName = "Checker" end
		local key = normalise(displayName)
		if #key >= 2 and not primaryKeys[key] then
			F.addCatalogRecord(index, {
				name = displayName,
				value = tonumber(value) or 0,
				image = image,
				category = cssClass,
				id = "fallback/" .. tostring(id),
				slug = sourceName,
			})
			added = added + 1
		end
		if parsed % 200 == 0 then task.wait() end
	end
	if parsed < 800 then return 0, false end
	return added, true
end

function F.refreshPublicCatalog()
	local requestOk, response = pcall(requestFn, {
		Url = CONFIG.PUBLIC_CATALOG_URL,
		Method = "GET",
		Timeout = CONFIG.HTTP_TIMEOUT_SECONDS,
	})
	assert(requestOk, "Public value catalog request failed: " .. tostring(response))
	assert(response and (response.Success == nil or response.Success),
		"Public value catalog request failed: " .. tostring(response and (response.StatusCode or response.Status)))
	local body = response.Body or response.body
	assert(type(body) == "string" and #body > 1000, "Public catalog returned an empty response.")
	local decodedOk, decoded = pcall(HttpService.JSONDecode, HttpService, body)
	assert(decodedOk and type(decoded) == "table", "Public catalog returned invalid JSON.")
	local nextValues = {}
	local itemCount = 0
	for category, tiers in pairs(decoded) do
		if type(tiers) == "table" then
			for tier, items in pairs(tiers) do
				if type(items) == "table" then
					for index, item in ipairs(items) do
						if type(item) == "table" and type(item.name) == "string" then
							F.addCatalogRecord(nextValues, {
								name = item.name,
								value = tonumber(item.value) or 0,
								demand = item.demand,
								stability = item.stability,
								image = item.image,
								wiki = item.wiki,
								category = category,
								id = tostring(category) .. "/" .. tostring(tier) .. "/" .. index,
								slug = item.name,
							})
							itemCount = itemCount + 1
							if itemCount % 250 == 0 then task.wait() end
						end
					end
				end
			end
		end
	end
	assert(itemCount >= 1000, "Public catalog validation failed; parsed only " .. itemCount .. " items.")
	valuesByName = nextValues
	resolutionCache = setmetatable({}, { __mode = "k" })
	shared.MM2TradeValuesCache = {
		schema = 7,
		values = nextValues,
		fallbackComplete = false,
		jobId = currentJobId,
		playerInstance = currentPlayerInstance,
	}
	valueCatalogLoading = false

	fallbackCatalogLoading = true
	task.spawn(function()
		local ok, added, complete = pcall(F.mergeFallbackCatalog, nextValues)
		fallbackCatalogLoading = false
		if running and ok and complete and valuesByName == nextValues then
			if added > 0 then resolutionCache = setmetatable({}, { __mode = "k" }) end
			shared.MM2TradeValuesCache = {
				schema = 7,
				values = nextValues,
				fallbackComplete = true,
				jobId = currentJobId,
				playerInstance = currentPlayerInstance,
			}
		end
	end)
end

