end

function F.findSlot(nameLabel, tradeGui)
	local node = nameLabel.Parent
	local fallback = nil
	while node and node ~= tradeGui do
		if node:IsA("GuiObject") then
			if normalise(node.Name):match("^newitem%d+$") then return node end
			if not fallback and node.AbsoluteSize.X >= 55 and node.AbsoluteSize.Y >= 55
				and (node:FindFirstChildWhichIsA("ImageLabel", true)
					or node:FindFirstChildWhichIsA("ImageButton", true)) then
				fallback = node
			end
		end
		node = node.Parent
	end
	return fallback or nameLabel.Parent
end

local metadataRevision = 0

function F.slotFingerprint(slot)
	local parts = {}
	local function add(value)
		value = tostring(value or "")
		if value ~= "" then table.insert(parts, value) end
	end
	local function inspect(object)
		add(object.Name)
		if object:IsA("TextLabel") or object:IsA("TextButton") then add(object.Text) end
		if object:IsA("ImageLabel") or object:IsA("ImageButton") then
			add(object.Image)
		end
		if object:IsA("ValueBase") then
			pcall(function() add(object.Value) end)
		end
		local ok, attributes = pcall(function() return object:GetAttributes() end)
		if ok then
			for key, value in pairs(attributes) do
				add(key)
				add(value)
			end
		end
	end
	inspect(slot)
	for _, object in ipairs(slot:GetDescendants()) do inspect(object) end
	return normalise(table.concat(parts, " "))
end

function F.slotKind(hint)
	if hint:find("gun", 1, true) or hint:find("pistol", 1, true)
		or hint:find("revolver", 1, true) then return "gun" end
	if hint:find("knife", 1, true) or hint:find("blade", 1, true)
		or hint:find("dagger", 1, true) then return "knife" end
	if hint:find("pet", 1, true) then return "pet" end
	return nil
end

function F.canonicalRarity(value)
	local key = normalise(value)
	if key:find("ancient", 1, true) then return "ancient" end
	if key:find("unique", 1, true) then return "unique" end
	if key:find("godly", 1, true) then return "godly" end
	if key:find("legend", 1, true) then return "legendary" end
	if key:find("uncommon", 1, true) then return "uncommon" end
	if key:find("common", 1, true) then return "common" end
	if key:find("rare", 1, true) then return "rare" end
	if key:find("vintage", 1, true) then return "vintage" end
	if key:find("pet", 1, true) then return "pet" end
	return key ~= "" and key or nil
end

function F.assetId(value)
	return tostring(value or ""):match("(%d%d%d%d%d%d+)")
end

local gameDatabaseItems = nil
local gameDatabaseRetryAt = 0
function F.buildGameDatabaseItems()
	if gameDatabaseItems then return gameDatabaseItems end
	if os.clock() < gameDatabaseRetryAt then
		return { byName = {}, byImage = {}, byItemId = {}, byInternal = {} }
	end
	local result = { byName = {}, byImage = {}, byItemId = {}, byInternal = {} }
	local ok, items = pcall(function()
		local replicatedStorage = game:GetService("ReplicatedStorage")
		local database = replicatedStorage:FindFirstChild("Database")
		local sync = database and database:FindFirstChild("Sync")
		local module = sync and sync:FindFirstChild("Item")
		return module and require(module) or nil
	end)
	if not ok or type(items) ~= "table" then
		local environmentOk, environment = pcall(function()
			return getrenv and getrenv() or nil
		end)
		local database = environmentOk and type(environment) == "table"
			and type(environment._G) == "table" and environment._G.Database or nil
		items = type(database) == "table" and database.Item or nil
	end
	if type(items) ~= "table" then
		gameDatabaseRetryAt = os.clock() + 2
		return result
	end
	local processedItems = 0
	for internalName, item in pairs(items) do
		processedItems = processedItems + 1
		if type(item) == "table" then
			local typeText = normalise(table.concat({
				tostring(internalName), tostring(item.ItemType or ""),
				tostring(item.Type or ""), tostring(item.WeaponType or ""),
				tostring(item.Category or ""),
			}, " "))
			local kind = F.slotKind(typeText)
			if kind then
				local image = tostring(item.Image or item.ImageId or item.ImageID
					or item.Texture or item.TextureId or item.TextureID or "")
				local metadata = {
					name = tostring(item.ItemName or item.DisplayName or item.Name or internalName),
					kind = kind,
					image = image,
					imageId = F.assetId(image),
					itemId = F.assetId(item.ItemID or item.AssetId or item.AssetID),
					year = tostring(item.Year or ""):match("%d%d%d%d"),
					rarity = F.canonicalRarity(item.Rarity or item.Tier or item.Category),
					chroma = normalise(item.Chroma) == "true"
						or normalise(internalName):find("chroma", 1, true) ~= nil,
					internalName = tostring(internalName),
					internalKey = normalise(internalName),
				}
				result.byInternal[metadata.internalKey] = metadata
				local names = {
					item.ItemName, item.DisplayName, item.Name, item.Title, internalName,
				}
				for _, name in ipairs(names) do
					local key = normalise(name)
					local base = key:gsub("gun$", ""):gsub("knife$", "")
					for _, alias in ipairs({ key, base }) do
						if #alias >= 2 then
							result.byName[alias] = result.byName[alias] or {}
							table.insert(result.byName[alias], metadata)
						end
					end
				end
				if metadata.imageId then
					result.byImage[metadata.imageId] = result.byImage[metadata.imageId] or {}
					table.insert(result.byImage[metadata.imageId], metadata)
				end
				if metadata.itemId then
					result.byItemId[metadata.itemId] = result.byItemId[metadata.itemId] or {}
					table.insert(result.byItemId[metadata.itemId], metadata)
				end
			end
		end
		if processedItems % 250 == 0 then task.wait() end
	end
	if next(result.byName) then
		gameDatabaseItems = result
	else
		gameDatabaseRetryAt = os.clock() + 2
	end
	return result
end

function F.selectDatabaseItem(candidates, query)
	local matching = {}
	for _, candidate in ipairs(candidates) do
		local base = candidate.internalKey:gsub("gun", ""):gsub("knife", "")
		if candidate.internalKey:find(query, 1, true) or base:find(query, 1, true) then
			table.insert(matching, candidate)
		end
	end
	if #matching == 1 then return matching[1] end
	if #candidates == 1 then return candidates[1] end
	return nil
	end

function F.gameDatabaseItem(query, visualKey)
	local database = F.buildGameDatabaseItems()
	local visualId = F.assetId(visualKey)
	if visualId then
		local exact = F.selectDatabaseItem(database.byImage[visualId] or {}, query)
		if exact then return exact end
		exact = F.selectDatabaseItem(database.byItemId[visualId] or {}, query)
		if exact then return exact end
	end
	return F.selectDatabaseItem(database.byName[query] or {}, query)
end

function F.colourCategory(colour)
	local r, g, b = colour.R, colour.G, colour.B
	if r > 0.6 and g > 0.55 and b < 0.3 then return "vintage" end
	if r > 0.65 and g > 0.25 and g < 0.65 and b < 0.25 then return "unique" end
	if r > 0.6 and b > 0.45 and g < 0.5 then return "godly" end
	if r > 0.25 and b > 0.5 and g < 0.4 then return "ancient" end
	if r > 0.55 and g < 0.35 and b < 0.35 then return "legend" end
	if g > 0.5 and r < 0.35 and b < 0.45 then return "rare" end
	if g > 0.55 and b > 0.55 and r < 0.35 then return "uncommon" end
	if math.max(r, g, b) - math.min(r, g, b) < 0.12 then return "common" end
	return nil
end

function F.slotCategory(slot, query)
	for _, object in ipairs(slot:GetDescendants()) do
		if (object:IsA("TextLabel") or object:IsA("TextButton"))
			and normalise(object.Text) == query then
			for _, node in ipairs({ object, object.Parent }) do
				if node and node:IsA("GuiObject") and node.BackgroundTransparency < 0.8 then
					local category = F.colourCategory(node.BackgroundColor3)
					if category then return category end
				end
			end
		end
	end
	return nil
end

local slotVisualCache = setmetatable({}, { __mode = "k" })
function F.slotVisualKey(slot)
	local database = F.buildGameDatabaseItems()
	local cached = slotVisualCache[slot]
	if cached and cached.object and cached.object:IsDescendantOf(slot) then
		local image = tostring(cached.object.Image or "")
		if image == cached.image then return image, cached.object end
		local id = F.assetId(image)
		if id and database.byImage[id] then
			cached.image = image
			return image, cached.object
		end
	end
	local fallback, fallbackObject = "", nil
	for _, object in ipairs(slot:GetDescendants()) do
		if object:IsA("ImageLabel") or object:IsA("ImageButton") then
			local image = tostring(object.Image or "")
			local id = F.assetId(image)
			if id and database.byImage[id] then
				slotVisualCache[slot] = { object = object, image = image }
				return image, object
			end
			if fallback == "" and image ~= "" then
				fallback, fallbackObject = image, object
			end
		end
	end
	if fallbackObject then slotVisualCache[slot] = { object = fallbackObject, image = fallback } end
	return fallback, fallbackObject
end

local starPetsSlotKinds = setmetatable({}, { __mode = "k" })
function F.itemKindForRub(slot, record, visualKey)
	visualKey = visualKey or F.slotVisualKey(slot)
	local cached = starPetsSlotKinds[slot]
	if cached and cached.kind and cached.visualKey == visualKey and cached.revision == metadataRevision then
		return cached.kind
	end
	local databaseItem = F.gameDatabaseItem(normalise(record.name), visualKey)
	local kind = databaseItem and databaseItem.kind
		or record.kind
		or (normalise(record.category) == "pets" and "pet")
		or F.slotKind(F.slotFingerprint(slot))
	if kind then
		starPetsSlotKinds[slot] = { visualKey = visualKey, revision = metadataRevision, kind = kind }
	end
	return kind
end

function F.recordYear(record)
	local text = table.concat({
		tostring(record.name or ""), tostring(record.image or ""),
		tostring(record.wiki or ""), tostring(record.slug or ""),
	}, " ")
	return text:match("(20%d%d)") or text:match("(19%d%d)")
end

function F.recordsEquivalent(candidates)
	local first = candidates[1]
	for index = 2, #candidates do
		local candidate = candidates[index]
		if tonumber(candidate.value) ~= tonumber(first.value)
			or tostring(candidate.stability) ~= tostring(first.stability) then
			return false
		end
	end
	return true
end

function F.majorityRecord(candidates, category)
	local filtered = {}
	for _, candidate in ipairs(candidates) do
		if not category or candidate.categoryKey == category then
			filtered[#filtered + 1] = candidate
		end
	end
	if #filtered == 0 then filtered = candidates end
	local groups, best, bestCount = {}, nil, 0
	for _, candidate in ipairs(filtered) do
		local key = tostring(candidate.value) .. ":" .. tostring(candidate.stability)
		local group = groups[key] or { count = 0, record = candidate }
		group.count = group.count + 1
		groups[key] = group
		if group.count > bestCount then
			best, bestCount = group.record, group.count
		end
	end
	if bestCount > #filtered / 2 then return best end
	return nil
end

function F.valueCandidateScore(candidate, context)
	local score = candidate.nameKey == context.query and 20 or 0
	if candidate.nameKey ~= context.query and #candidate.nameKey >= 4
		and context.hint:find(candidate.nameKey, 1, true) then score = score + 350 end
	if context.kind and candidate.kind == context.kind then
		score = score + 500
	elseif context.kind and candidate.kind and candidate.kind ~= context.kind then
		score = score - 300
	end
	local rarity = F.canonicalRarity(candidate.categoryKey)
	if context.category and rarity == context.category then
		score = score + 450
	elseif context.category and rarity ~= context.category then
		score = score - 250
	end
	local year = F.recordYear(candidate)
	local databaseItem = context.databaseItem
	if databaseItem and databaseItem.year and year then
		score = score + (year == databaseItem.year and 700 or -700)
	end
	for _, token in ipairs(candidate.tokens or {}) do
		if databaseItem and databaseItem.internalKey
			and (token == databaseItem.internalKey
				or token:find(databaseItem.internalKey, 1, true)) then
			score = score + 1200
		end
		if token ~= context.query and #token >= 5
			and context.hint:find(token, 1, true) then score = score + 700 end
		for tokenYear in token:gmatch("20%d%d") do
			if context.hint:find(tokenYear, 1, true) then score = score + 180 end
		end
	end
	return score
end

function F.pickValueRecord(candidates, context)
	local best, bestScore, secondScore = nil, -math.huge, -math.huge
	for _, candidate in ipairs(candidates) do
		local score = F.valueCandidateScore(candidate, context)
		if score > bestScore then
			secondScore, bestScore, best = bestScore, score, candidate
		elseif score > secondScore then
			secondScore = score
		end
	end
	if best and bestScore >= 100 and bestScore > secondScore then return best end
	return nil
end

function F.resolveRecord(displayText, slot)
	local query = normalise(displayText)
	local candidates = valuesByName[query]
	if not candidates or #candidates == 0 then return nil end
	if #candidates == 1 or F.recordsEquivalent(candidates) then return candidates[1] end
	local visualKey = F.slotVisualKey(slot)
	local cached = resolutionCache[slot]
	if cached and cached.query == query and cached.visualKey == visualKey
		and cached.revision == metadataRevision then return cached.record end
	local databaseItem = F.gameDatabaseItem(query, visualKey)
	local category = databaseItem and databaseItem.rarity or F.slotCategory(slot, query)
	local context = {
		query = query,
		hint = F.slotFingerprint(slot),
		category = category,
		databaseItem = databaseItem,
	}
	context.kind = databaseItem and databaseItem.kind or F.slotKind(context.hint)
	local resolved = F.pickValueRecord(candidates, context)
		or F.majorityRecord(candidates, category)
	resolutionCache[slot] = {
		query = query, visualKey = visualKey,
		revision = metadataRevision, record = resolved,
	}
	return resolved
end

function F.isItemCard(slot)
	if not slot or not slot:IsA("GuiObject") then return false end
	local size = slot.AbsoluteSize
	local offerSlot = normalise(slot.Name):match("^newitem%d+$") ~= nil
	local maxWidth, maxHeight = offerSlot and 640 or 300, offerSlot and 640 or 340
	if size.X < 55 or size.Y < 55 or size.X > maxWidth or size.Y > maxHeight then return false end
	return slot:FindFirstChildWhichIsA("ImageLabel", true) ~= nil
		or slot:FindFirstChildWhichIsA("ImageButton", true) ~= nil
end

local NON_ITEM_LABELS = {}
for _, text in ipairs({
	"Profile", "Weapons", "Effects", "Powers", "Emotes", "Radios", "Pets",
	"Season 1", "Classic", "Holiday", "Search", "View", "Redeem", "EnterCode",
	"Accept", "Decline", "Add Items", "Your Offer", "Their Offer", "Total",
	"Chroma", "Normal",
}) do NON_ITEM_LABELS[normalise(text)] = true end

function F.itemNameLabelSlot(object, gui)
	if not (object:IsA("TextLabel") or object:IsA("TextButton")) then return nil end
	if object.Name == OVERLAY_NAME or object.Name == INVENTORY_OVERLAY_NAME
		or object.Name == TOTAL_NAME then return nil end
	local text = tostring(object.Text or ""):match("^%s*(.-)%s*$")
	local key = normalise(text)
	if #key < 1 or #text > 45 or NON_ITEM_LABELS[key] then return nil end
	local slot = F.findSlot(object, gui)
	if not F.isItemCard(slot) then return nil end
	local relativeY = object.AbsolutePosition.Y + object.AbsoluteSize.Y / 2
		- slot.AbsolutePosition.Y
	if relativeY < slot.AbsoluteSize.Y * 0.62 then return nil end
	if object.AbsoluteSize.X < slot.AbsoluteSize.X * 0.42 then return nil end
	return slot
end

function F.makeOverlay(slot, overlayName)
	local label = slot:FindFirstChild(overlayName)
	if label then return label end
	label = F.textObject("TextLabel")
	label.Name = overlayName
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.Position = UDim2.fromOffset(6, 3)
	label.Size = UDim2.new(1, -12, 0, 30)
	label.Font = Enum.Font.GothamMedium
	label.TextColor3 = ITEM_TEXT
	label.TextSize = 12
	label.TextStrokeColor3 = ITEM_OUTLINE
	label.TextStrokeTransparency = 0.25
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Top
	label.RichText = true
	label.LineHeight = 0.9
	label.ZIndex = 1000
	label.Parent = slot

	return label
end

function F.richEscape(value)
	return tostring(value or "")
		:gsub("&", "&amp;")
		:gsub("<", "&lt;")
		:gsub(">", "&gt;")
end

function F.statusColour(status)
	local text = tostring(status or ""):lower()
	if text:find("stable", 1, true) then return "#67E8B2" end
	if text:find("well", 1, true) or text:find("rising", 1, true)
		or text:find("overpaid", 1, true) then return "#79F28B" end
	if text:find("underpaid", 1, true) or text:find("decreas", 1, true)
		or text:find("dropping", 1, true) then return "#FF8585" end
	return "#C8CDD5"
end

function F.rubNumber(value)
	value = tonumber(value)
	if not value then return "?" end
	if math.abs(value - math.round(value)) < 0.001 then return tostring(math.round(value)) end
	return ("%.2f"):format(value):gsub("0+$", ""):gsub("%.$", "")
end

function F.addStarPetsItem(index, item)
	if type(item) ~= "table" or not tonumber(item.price) then return end
	local aliases, seen = {}, {}
	local function addAlias(value)
		local key = normalise(value)
		if #key >= 2 and not seen[key] then
			seen[key] = true
			table.insert(aliases, key)
		end
	end
	addAlias(item.name)
	addAlias(item.realName)
	addAlias(item.imageId)
	for _, key in ipairs(aliases) do
		index[key] = index[key] or {}
		table.insert(index[key], item)
		local base = key:gsub("gun$", ""):gsub("knife$", "")
		if #base >= 2 and base ~= key then
			index[base] = index[base] or {}
			table.insert(index[base], item)
		end
	end
end

function F.textObject(className)
	local object = Instance.new(className)
	object.AutoLocalize = false
	return object
end

function F.addStarPetsItems(index, items)
	for itemIndex, item in ipairs(items) do
		F.addStarPetsItem(index, item)
		if itemIndex % 120 == 0 then task.wait() end
	end
end

function F.requestStarPetsPage(page, filterName)
	local filter = { types = {
		{ type = "weapon" }, { type = "pet" }, { type = "misc" },
	} }
	if filterName and filterName ~= "" then filter.name = filterName end
	local payload = HttpService:JSONEncode({
		filter = filter,
		page = page,
		amount = CONFIG.STARPETS_PAGE_SIZE,
		currency = "rub",
		sort = { popularity = "desc" },
	})
	local lastError = "unknown response"
	local attempts = filterName and 1 or 2
	for attempt = 1, attempts do
		local requestOk, response = pcall(requestFn, {
			Url = CONFIG.STARPETS_API_URL,
			Method = "POST",
			Headers = {
				["Content-Type"] = "application/json",
				["Accept"] = "application/json",
			},
			Body = payload,
			Timeout = filterName and 5 or CONFIG.HTTP_TIMEOUT_SECONDS,
		})
		local status = requestOk and response and (response.StatusCode or response.Status)
		if requestOk and response and (response.Success == nil or response.Success)
			and (not status or status == 200) then
			local ok, decoded = pcall(
				HttpService.JSONDecode, HttpService, response.Body or response.body or ""
			)
			if ok and type(decoded) == "table" and decoded.status == true
				and type(decoded.items) == "table" then
				return decoded
			end
			lastError = "invalid JSON"
		elseif requestOk then
			lastError = "HTTP " .. tostring(status)
		else
			lastError = tostring(response)
		end
		if attempt < attempts then task.wait(0.25) end
	end
	error("StarPets request " .. tostring(filterName or page) .. " failed: " .. lastError)
end

function F.refreshStarPetsCatalog()
	local first = F.requestStarPetsPage(1)
	local count = tonumber(first.count) or #first.items
	local pageCount = math.max(1, math.ceil(count / CONFIG.STARPETS_PAGE_SIZE))
	local nextIndex, itemCount = {}, #first.items
	F.addStarPetsItems(nextIndex, first.items)
	local workersDone, failed = 0, nil
	local workerCount = math.min(CONFIG.STARPETS_WORKERS, math.max(0, pageCount - 1))

	local completed = Instance.new("BindableEvent")
	for workerIndex = 1, workerCount do
		task.spawn(function()
			for page = workerIndex + 1, pageCount, workerCount do
				if not running or failed then break end
				local ok, result = pcall(F.requestStarPetsPage, page)
				if ok then
					F.addStarPetsItems(nextIndex, result.items)
					itemCount = itemCount + #result.items
				else
					failed = tostring(result)
				end
			end
			workersDone = workersDone + 1
			completed:Fire()
		end)
	end
	while running and workersDone < workerCount do completed.Event:Wait() end
	completed:Destroy()
	assert(running, "script stopped")
	assert(not failed, failed)

	if itemCount < 300 then warn("StarPets catalog partial: " .. itemCount) end
	starPetsState.byName = nextIndex
	starPetsState.complete = true
	starPetsCatalogComplete = true
	starPetsCatalogRevision = starPetsCatalogRevision + 1
	starPetsResolutionCache = setmetatable({}, { __mode = "k" })
	F.markDirty()
end

function F.startStarPetsCatalogRefresh()
	if starPetsCatalogLoading or os.clock() < starPetsCatalogRetryAt then return end
	if starPetsState.complete == true and next(starPetsState.byName) ~= nil then
		starPetsCatalogComplete = true
		return
	end
	starPetsCatalogComplete = false
	starPetsState.complete = false
	starPetsCatalogLoading = true
	task.spawn(function()
		local ok = pcall(F.refreshStarPetsCatalog)
		starPetsCatalogLoading = false
		if not ok and running then
			starPetsCatalogRetryCount = starPetsCatalogRetryCount + 1
			local retryDelay = math.min(30, 6 * starPetsCatalogRetryCount)
			starPetsCatalogRetryAt = os.clock() + retryDelay
			if starPetsCatalogRetryCount <= 4 then
				task.delay(retryDelay + 0.2, function()
					if running and not starPetsCatalogComplete then
						F.startStarPetsCatalogRefresh()
					end
				end)
			end
		else
			starPetsCatalogRetryAt = 0
			starPetsCatalogRetryCount = 0
		end
	end)
end

function F.finishStarPetsLookup(job, ok, result)
	local state = starPetsLookupState[job.key]
	if state then
		state.pending = false
		if ok then
			F.addStarPetsItems(starPetsState.byName, result.items)
			state.done, state.failed, state.failures = true, false, 0
			starPetsCatalogRevision = starPetsCatalogRevision + 1
			starPetsResolutionCache = setmetatable({}, { __mode = "k" })
			F.markDirty()
		else
			state.failures = (state.failures or 0) + 1
			if state.failures >= 3 then
				state.done, state.failed = true, true
			else
				state.retryAt = os.clock() + 5
			end
		end
	end
	if running then F.starPetsLookupSignal:Fire() end
end

function F.startStarPetsLookupWorkers()
	if not running or starPetsLookupActive >= CONFIG.STARPETS_LOOKUP_WORKERS then return end
	local job = starPetsLookupQueue[starPetsLookupHead]
	if not job then return end
	starPetsLookupQueue[starPetsLookupHead] = nil
	starPetsLookupHead = starPetsLookupHead + 1
	starPetsLookupActive = starPetsLookupActive + 1
	task.spawn(function()
		local ok, result = pcall(F.requestStarPetsPage, 1, job.text)
		F.finishStarPetsLookup(job, ok, result)
		starPetsLookupActive = starPetsLookupActive - 1
		F.startStarPetsLookupWorkers()
	end)
	F.startStarPetsLookupWorkers()
end

function F.queueStarPetsLookup(displayText, highPriority)
	local key = normalise(displayText)
	if #key < 2 then return nil end
	local state = starPetsLookupState[key]
	if state and (state.pending or state.done
		or (state.retryAt and state.retryAt > os.clock())) then return state end
	state = state or {}
	state.pending, state.done, state.failed, state.retryAt = true, false, false, nil
	starPetsLookupState[key] = state
	local job = { key = key, text = tostring(displayText) }
	if highPriority then
		starPetsLookupHead = starPetsLookupHead - 1
		starPetsLookupQueue[starPetsLookupHead] = job
	else
		starPetsLookupTail = starPetsLookupTail + 1
		starPetsLookupQueue[starPetsLookupTail] = job
	end
	F.startStarPetsLookupWorkers()
	return state
end

function F.loadPriorityStarPets(names)
	local states = {}
	local alreadyReady = 0
	local limit = math.min(#names, CONFIG.PRIORITY_LOOKUP_LIMIT)
	for index = 1, limit do
		local displayName = names[index]
		local cached = starPetsState.byName[normalise(displayName)]
		if cached and #cached > 0 then
			alreadyReady = alreadyReady + 1
		else
			local state = F.queueStarPetsLookup(displayName)
			if state then states[#states + 1] = state end
		end
	end
	local total = alreadyReady + #states
	local deadline = os.clock() + CONFIG.PRIORITY_TIMEOUT_SECONDS
	task.delay(CONFIG.PRIORITY_TIMEOUT_SECONDS, function()
		if running then F.starPetsLookupSignal:Fire() end
	end)
	while running and os.clock() < deadline do
		local settled = alreadyReady
		for _, state in ipairs(states) do
			if state.done or not state.pending then settled = settled + 1 end
		end
		F.setLoadingState(
			("SERVER ITEM PRICES · %d/%d"):format(settled, total),
			0.38 + (total > 0 and 0.46 * settled / total or 0.46)
		)
		if settled >= total then break end
		F.starPetsLookupSignal.Event:Wait()
	end
	local found = 0
	for index = 1, limit do
		local displayName = names[index]
		local cached = starPetsState.byName[normalise(displayName)]
		if cached and #cached > 0 then found = found + 1 end
	end
	return found
end

function F.addStarPetsCandidates(output, seen, index, key)
	for _, candidate in ipairs(index[key] or {}) do
		local id = tostring(candidate.id or candidate.goodId or candidate)
		if not seen[id] then
			seen[id] = true
			output[#output + 1] = candidate
		end
	end
end

function F.collectStarPetsCandidates(query)
	local output, seen = {}, {}
	local index = starPetsState.byName
	F.addStarPetsCandidates(output, seen, index, query)
	F.addStarPetsCandidates(output, seen, index, query:gsub("gun$", ""))
	F.addStarPetsCandidates(output, seen, index, query:gsub("knife$", ""))
	if query:sub(-3) == "ies" then
		F.addStarPetsCandidates(output, seen, index, query:sub(1, -4) .. "y")
	end
	if query:sub(-1) == "s" then
		F.addStarPetsCandidates(output, seen, index, query:sub(1, -2))
	end
	return output
end

function F.starPetsContext(displayText, record, slot, visualKey)
	local context = {}
	context.query = normalise(displayText or record.name)
	context.visualKey = visualKey or F.slotVisualKey(slot)
	context.databaseItem = F.gameDatabaseItem(context.query, context.visualKey)
	local databaseItem = context.databaseItem
	context.kind = databaseItem and databaseItem.kind
		or F.itemKindForRub(slot, record, context.visualKey)
	context.year = databaseItem and databaseItem.year or F.recordYear(record)
	context.rarity = databaseItem and databaseItem.rarity
		or F.canonicalRarity(record.category)
	context.hint = normalise(table.concat({
		tostring(record.image or ""), tostring(record.wiki or ""),
		tostring(record.slug or ""), context.visualKey,
	}, " "))
	context.chroma = databaseItem and databaseItem.chroma
	if not databaseItem then
		context.chroma = context.query:find("chroma", 1, true) ~= nil
			or context.hint:find("chroma", 1, true) ~= nil
	end
	return context
end

function F.starPetsCacheMatches(cached, context)
	return cached and cached.query == context.query
		and cached.visualKey == context.visualKey
		and cached.desiredKind == context.kind
		and cached.desiredYear == context.year
		and cached.desiredRarity == context.rarity
		and cached.desiredChroma == context.chroma
		and cached.hint == context.hint
		and cached.catalogRevision == starPetsCatalogRevision
		and cached.metadataRevision == metadataRevision
end

function F.starPetsCandidateData(candidate)
	local text = normalise(table.concat({
		tostring(candidate.name or ""), tostring(candidate.realName or ""),
		tostring(candidate.imageId or ""),
	}, " "))
	local kind = tostring(candidate.subtype or ""):lower()
	if kind == "" and tostring(candidate.type):lower() == "pet" then kind = "pet" end
	local rawRarity = candidate.rare or candidate.rarity
	return {
		chroma = candidate.chroma == true or normalise(candidate.chroma) == "true"
			or text:find("chroma", 1, true) ~= nil,
		kind = kind,
		year = tostring(candidate.year or ""),
		rarity = type(rawRarity) == "string" and F.canonicalRarity(rawRarity) or nil,
	}
end

function F.starPetsCandidateScore(candidate, context)
	local data = F.starPetsCandidateData(candidate)
	if data.chroma ~= context.chroma
		or (context.kind and data.kind ~= "" and data.kind ~= context.kind)
		or (context.year and data.year ~= "" and data.year ~= context.year)
		or (context.rarity and data.rarity and data.rarity ~= context.rarity) then
		return nil
	end
	local score = normalise(candidate.name) == context.query and 500 or 0
	if context.kind and data.kind == context.kind then score = score + 700 end
	if context.year and data.year == context.year then score = score + 700 end
	if context.rarity and data.rarity == context.rarity then score = score + 500 end
	score = score + 600
	local internal = normalise(candidate.realName or candidate.imageId)
	if context.databaseItem and internal == context.databaseItem.internalKey then
		score = score + 2500
	end
	local visualId = F.assetId(context.visualKey)
	if visualId and F.assetId(candidate.imageId) == visualId then score = score + 2500 end
	for _, rawToken in ipairs({ candidate.realName, candidate.imageId }) do
		local token = normalise(rawToken)
		if #token >= 5 and token ~= context.query
			and context.hint:find(token, 1, true) then score = score + 900 end
	end
	return score
end

function F.pickStarPetsItem(candidates, context)
	local best, bestScore, secondScore = nil, -math.huge, -math.huge
	local allSamePrice, firstPrice = true, nil
	for _, candidate in ipairs(candidates) do
		local score = F.starPetsCandidateScore(candidate, context)
		if score then
			local price = tonumber(candidate.price)
			if firstPrice == nil then firstPrice = price
			elseif price ~= firstPrice then allSamePrice = false end
			if score > bestScore then
				secondScore, bestScore, best = bestScore, score, candidate
			elseif score > secondScore then
				secondScore = score
			end
		end
	end
	if #candidates > 1 and bestScore == secondScore and not allSamePrice then return nil end
	return best
end

function F.resolveStarPetsItem(displayText, record, slot, visualKey)
	local context = F.starPetsContext(displayText, record, slot, visualKey)
	local cached = starPetsResolutionCache[slot]
	if F.starPetsCacheMatches(cached, context) then return cached.item end
	local candidates = F.collectStarPetsCandidates(context.query)
	local item = F.pickStarPetsItem(candidates, context)
	starPetsResolutionCache[slot] = {
		query = context.query, visualKey = context.visualKey,
		catalogRevision = starPetsCatalogRevision, metadataRevision = metadataRevision,
		desiredKind = context.kind, desiredYear = context.year,
		desiredRarity = context.rarity, desiredChroma = context.chroma,
		hint = context.hint, item = item,
	}
	return item
end

function F.ensureRubPrice(record, slot, displayText, visualKey)
	if not priorityLoadingActive then F.startStarPetsCatalogRefresh() end
	local item = F.resolveStarPetsItem(displayText, record, slot, visualKey)
	if item then
		return {
			price = tonumber(item.price), average = tonumber(item.avgPrice),
			id = item.id, name = item.name, pending = false,
		}
	end
	if not item then
		local state = F.queueStarPetsLookup(displayText, true)
		if not state or not state.done then return { pending = true } end
		item = F.resolveStarPetsItem(displayText, record, slot, visualKey)
		if not item then
			return { unavailable = true, sourceUnavailable = false }
		end
	end
	return {
		price = tonumber(item.price),
		average = tonumber(item.avgPrice),
		id = item.id,
		name = item.name,
		pending = false,
	}
end

