function F.watchProperty(object, property)
	if not object then return end
	local watched = watchedProperties[object]
	if not watched then
		watched = {}
		watchedProperties[object] = watched
	end
	if watched[property] then return end
	watched[property] = true
	local ok, signal = pcall(function() return object:GetPropertyChangedSignal(property) end)
	if not ok then return end
	table.insert(cleanupConnections, signal:Connect(function()
		F.markDirty()
	end))
end

function F.watchVisibility(object, root)
