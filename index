function F.updateModeSelector(inventoryGui, tradeGui)
	modeVisibilityRevision = modeVisibilityRevision + 1
	local revision = modeVisibilityRevision
	if not inventoryGui and not tradeGui then
		if modeGui and modeGui.Enabled then
			task.delay(0.14, function()
				if running and revision == modeVisibilityRevision and modeGui then
					modeGui.Enabled = false
				end
			end)
		end
		return
	end
	F.makeModeSelector()
	if not modeGui.Enabled then modeGui.Enabled = true end
end

function F.setOverlayText(overlay, text)
	if overlay.Text ~= text then overlay.Text = text end
end

function F.formatValue(value)
	value = tonumber(value) or 0
	if math.abs(value - math.round(value)) < 0.00001 then
		return tostring(math.round(value))
	end
	return ("%.6f"):format(value):gsub("0+$", ""):gsub("%.$", "")
end

function F.panelRightEdge(header, tradeGui)
	local best, bestArea = nil, math.huge
	local node = header
	while node and node ~= tradeGui do
		if node:IsA("GuiObject") and node.AbsoluteSize.X >= 350 and node.AbsoluteSize.Y >= 250 then
			local area = node.AbsoluteSize.X * node.AbsoluteSize.Y
			if area < bestArea then
				best, bestArea = node, area
			end
		end
		node = node.Parent
	end
	if best then
		return best.AbsolutePosition.X + best.AbsoluteSize.X
	end
	return header.AbsolutePosition.X + header.AbsoluteSize.X
end

function F.offerFrameForHeader(header, tradeGui)
	local node = header
	while node and node ~= tradeGui do
		local name = normalise(node.Name)
		if name == "youroffer" or name == "theiroffer" then return node end
		node = node.Parent
	end
	return nil
end

function F.horizontalTextBounds(label)
	local left = label.AbsolutePosition.X
	local width = label.AbsoluteSize.X
	local textWidth = math.min(width, label.TextBounds and label.TextBounds.X or 0)
	if label.TextXAlignment == Enum.TextXAlignment.Center then
		left = left + (width - textWidth) / 2
	elseif label.TextXAlignment == Enum.TextXAlignment.Right then
		left = left + width - textWidth
	end
	return left, left + textWidth
end

function F.mobileTotalBounds(header, tradeGui)
	local offerFrame = F.offerFrameForHeader(header, tradeGui)
	local tutorial = offerFrame and offerFrame:FindFirstChild("Tutorial")
	if not (tutorial and tutorial:IsA("TextLabel") and tutorial.Visible) then return nil end
	local _, titleRight = F.horizontalTextBounds(header)
	local tutorialLeft = F.horizontalTextBounds(tutorial)
	local left = math.floor(titleRight + 10)
	local right = math.floor(tutorialLeft - 10)
	if right - left < 72 then return nil end
	local height = math.clamp(math.floor(header.AbsoluteSize.Y * 0.72), 22, 34)
	local y = math.floor(header.AbsolutePosition.Y + (header.AbsoluteSize.Y - height) / 2 + 1)
	return left, y, right - left, height
end

function F.makeTotalLabel(tradeGui, header)
	local label = tradeGui:FindFirstChild(TOTAL_NAME)
	if not label then
		label = F.textObject("TextLabel")
		label.Name = TOTAL_NAME
		label.BackgroundTransparency = 1
		label.BorderSizePixel = 0
		label.Size = UDim2.fromOffset(180, 30)
		label.Font = Enum.Font.GothamBold
		label.TextSize = 18
		label.TextStrokeColor3 = Color3.fromRGB(17, 30, 18)
		label.TextStrokeTransparency = 0.2
		label.TextXAlignment = Enum.TextXAlignment.Right
		label.TextYAlignment = Enum.TextYAlignment.Center
		label.ZIndex = 1001
		label.Parent = tradeGui
		local constraint = Instance.new("UITextSizeConstraint")
		constraint.Name = "ResponsiveTextSize"
		constraint.MinTextSize = 9
		constraint.MaxTextSize = 18
		constraint.Parent = label
	end
	totalLabelReference = label
	if not label.Visible then label.Visible = true end
	local mobileLeft, mobileY, mobileWidth, mobileHeight = F.mobileTotalBounds(header, tradeGui)
	if mobileLeft then
		label.TextScaled = true
		label.TextXAlignment = Enum.TextXAlignment.Center
		local mobileSize = UDim2.fromOffset(mobileWidth, mobileHeight)
		local mobilePosition = UDim2.fromOffset(mobileLeft, mobileY)
		if label.Size ~= mobileSize then label.Size = mobileSize end
		if label.Position ~= mobilePosition then label.Position = mobilePosition end
		return label
	end
	label.TextScaled = false
	label.TextSize = 18
	label.TextXAlignment = Enum.TextXAlignment.Right
	local right = F.panelRightEdge(header, tradeGui) - 14
	local headingWidth = header.TextBounds and header.TextBounds.X or 0
	local left = header.AbsolutePosition.X + math.max(180, headingWidth + 24)
	if right - left < 120 then left = right - 120 end
	local width = math.max(120, right - left)
	local size = UDim2.fromOffset(width, 30)
	local position = UDim2.fromOffset(
		left,
		header.AbsolutePosition.Y + math.floor((header.AbsoluteSize.Y - 30) / 2) + 3
	)
	if label.Size ~= size then label.Size = size end
	if label.Position ~= position then label.Position = position end
	return label
end

function F.updateTotal(tradeGui, regions, yourTotal, theirTotal, hasUnknown)
	local yourHeader = nil
	for _, region in ipairs(regions) do
		if region.side == "your" then yourHeader = region.header end
	end
	if not yourHeader then return end

	local difference = theirTotal - yourTotal
	local label = F.makeTotalLabel(tradeGui, yourHeader)
	local text, colour
	local suffix = displayMode == "rub" and " ₽" or ""
	if hasUnknown then
		text, colour = "TOTAL: ?", Color3.fromRGB(255, 184, 107)
	elseif difference > 0 then
		text, colour = "TOTAL: +" .. F.formatValue(difference) .. suffix, POSITIVE
	elseif difference < 0 then
		text, colour = "TOTAL: -" .. F.formatValue(math.abs(difference)) .. suffix, NEGATIVE
	else
		text, colour = "TOTAL: ±0" .. suffix, ITEM_TEXT
	end
	if label.Text ~= text then label.Text = text end
	if label.TextColor3 ~= colour then label.TextColor3 = colour end
end

function F.collectVisibleCardSlots(gui, now)
	local scanRoot = gui
	if gui.Name == "MainGUI" then
		local gameFrame = gui:FindFirstChild("Game")
		local inv = gameFrame and gameFrame:FindFirstChild("Inventory")
		if inv and inv.Visible then
			scanRoot = inv:FindFirstChild("Main") or inv
		end
	elseif gui.Name == "TradeGUI" or gui.Name == "TradeGUI_Phone" then
		local container = gui:FindFirstChild("Container")
		if container and container.Visible then
			scanRoot = container
		end
	end

	local descendants = scanRoot:GetDescendants()
	local labelsBySlot = {}
	for _, object in ipairs(descendants) do
		if object:IsA("TextLabel")
			and (object.Name == OVERLAY_NAME or object.Name == INVENTORY_OVERLAY_NAME) then
			local lastSeen = (object.Name == OVERLAY_NAME and overlayLastSeen
				or inventoryLastSeen)[object]
			if object.Visible and lastSeen and now - lastSeen > CONFIG.HIDE_AFTER_SECONDS then
				object.Visible = false
			end
		elseif (object:IsA("TextLabel") or object:IsA("TextButton"))
			and F.isEffectivelyVisible(object, gui) then
			local slot = F.itemNameLabelSlot(object, gui)
			if slot then
				local centreY = object.AbsolutePosition.Y + object.AbsoluteSize.Y / 2
				local previous = labelsBySlot[slot]
				if not previous or centreY > previous.y then
					labelsBySlot[slot] = { object = object, y = centreY }
				end
			end
		end
	end
	return labelsBySlot
end

function F.updateCard(slot, selected, regions, now)
	local object = selected.object
	F.watchProperty(object, "Text")
	local query = normalise(object.Text)
	local candidates = valuesByName[query]
	local region = regions and F.offerRegionFor(slot, regions) or nil
	local visualKey, visualObject = F.slotVisualKey(slot)
	if visualObject then F.watchProperty(visualObject, "Image") end
	local databaseItem = F.gameDatabaseItem(query, visualKey)
	local defaultItem = DEFAULT_ITEMS[query] or (databaseItem
		and databaseItem.rarity == "unique" and databaseItem.internalKey ~= "corrupt")
	local record = candidates and F.resolveRecord(object.Text, slot) or nil
	local overlay = F.makeOverlay(slot, region and OVERLAY_NAME or INVENTORY_OVERLAY_NAME)
	if not overlay.Visible then overlay.Visible = true end
	(region and overlayLastSeen or inventoryLastSeen)[overlay] = now
	local shownValue
	if defaultItem then
		F.setOverlayText(overlay, F.displayDefaultItem())
		shownValue = 0
	elseif displayMode == "rub" then
		local lookupRecord = record or {
			name = object.Text, image = visualKey, category = "",
		}
		local entry = F.ensureRubPrice(lookupRecord, slot, object.Text, visualKey)
		F.setOverlayText(overlay, F.displayRubPrice(entry))
		shownValue = entry and tonumber(entry.price)
	elseif record then
		record.valueOverlayText = record.valueOverlayText or F.displayValue(record)
		F.setOverlayText(overlay, record.valueOverlayText)
		local numeric = tonumber(record.value)
		shownValue = numeric and numeric > 0 and numeric or nil
	else
		local pending = valueCatalogLoading or fallbackCatalogLoading
		F.setOverlayText(overlay, F.displayUnknownValue(pending, not pending and not candidates))
	end
	return region, shownValue
end

function F.updateCards(gui, regions, now)
	local yourTotal, theirTotal, hasUnknown = 0, 0, false
	local processedSlots = 0
	for slot, selected in pairs(F.collectVisibleCardSlots(gui, now)) do
		processedSlots = processedSlots + 1
		local region, shownValue = F.updateCard(slot, selected, regions, now)
		if region and shownValue then
			if region.side == "their" then theirTotal = theirTotal + shownValue
			else yourTotal = yourTotal + shownValue end
		elseif region then
			hasUnknown = true
		end
		if processedSlots % 16 == 0 then task.wait() end
	end
	return yourTotal, theirTotal, hasUnknown
end

function F.updateOverlays()
	local now = os.clock()
	local tradeGui = F.findTradeGui()
	local inventoryGui = F.findInventoryGui()
	F.updateModeSelector(inventoryGui, tradeGui)
	if tradeGui ~= lastTradeGui or inventoryGui ~= lastInventoryGui then
		lastTradeGui, lastInventoryGui = tradeGui, inventoryGui
		uiDirty = true
	end
	if not uiDirty and now - lastFullScan < CONFIG.FULL_SCAN_SECONDS then return end
	uiDirty = false
	lastFullScan = now
	local regions = tradeGui and F.offerRegions(tradeGui) or nil

	local currentYourTotal, currentTheirTotal, currentHasUnknown = 0, 0, false
	if tradeGui and regions and #regions >= 2 then
		currentYourTotal, currentTheirTotal, currentHasUnknown =
			F.updateCards(tradeGui, regions, now)
	elseif totalLabelReference then
		totalLabelReference.Visible = false
	end
	if inventoryGui and inventoryGui ~= tradeGui then
		F.updateCards(inventoryGui, nil, now)
	end
	if not tradeGui or not regions or #regions < 2 then
		displayedYourTotal, displayedTheirTotal, displayedHasUnknown = 0, 0, false
		pendingTotalsKey = nil
		return
	end

	local totalsKey = ("%s:%.6f:%.6f:%s"):format(
		displayMode, currentYourTotal, currentTheirTotal, currentHasUnknown and "?" or "ok"
	)
	if totalsKey ~= pendingTotalsKey then
		pendingTotalsKey = totalsKey
		pendingTotalsSince = now
		F.markDirty(0.2)
	elseif now - pendingTotalsSince >= CONFIG.SCAN_SECONDS * 0.8 then
		displayedYourTotal = currentYourTotal
		displayedTheirTotal = currentTheirTotal
		displayedHasUnknown = currentHasUnknown
	end
	F.updateTotal(tradeGui, regions, displayedYourTotal, displayedTheirTotal,
		displayedHasUnknown)
end

function F.scheduleFallbackScan()
	task.delay(CONFIG.FULL_SCAN_SECONDS, function()
		if not running then return end
		F.markDirty(0)
		F.scheduleFallbackScan()
	end)
end

