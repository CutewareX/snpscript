function F.collectOwnedDisplayNames(profile, output)
	local database = F.buildGameDatabaseItems()
	for _, sectionName in ipairs({ "Weapons", "Pets" }) do
		local section = type(profile) == "table" and profile[sectionName]
		local owned = type(section) == "table" and section.Owned
		if type(owned) == "table" then
			for key, value in pairs(owned) do
				local internalName
				if type(key) == "string" and type(value) == "number" and value > 0 then
					internalName = key
				elseif type(value) == "string" then
					internalName = value
				elseif type(value) == "table" then
					internalName = value.ItemName or value.Name or value.ID
				end
				if internalName then
					local metadata = database.byInternal[normalise(internalName)]
					local displayName = metadata and metadata.name or tostring(internalName)
					local displayKey = normalise(displayName)
					if #displayKey >= 2 and not DEFAULT_ITEMS[displayKey] then
						output[displayKey] = displayName
					end
				end
			end
		end
	end
end

function F.collectServerPriorityNames()
	local names = {}
	local players = Players:GetPlayers()
	local inventoryFolder = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes")
		and game:GetService("ReplicatedStorage").Remotes:FindFirstChild("Extras")
	local remote = inventoryFolder and inventoryFolder:FindFirstChild("GetFullInventory")
	if not remote or not remote:IsA("RemoteFunction") or #players == 0 then
		return names
	end

	local scanned, workersDone = 0, 0
	local workers = math.min(3, #players)
	local completed = Instance.new("BindableEvent")
	for workerIndex = 1, workers do
		task.spawn(function()
			for index = workerIndex, #players, workers do
				if not running then break end
				local target = players[index]
				local ok, profile = pcall(function()
					return remote:InvokeServer(target)
				end)
				if ok then F.collectOwnedDisplayNames(profile, names) end
				scanned = scanned + 1
				F.setLoadingState(
					("SERVER INVENTORIES · %d/%d"):format(scanned, #players),
					0.05 + 0.30 * scanned / #players
				)
				task.wait(0.04)
			end
			workersDone = workersDone + 1
			completed:Fire()
		end)
	end
	while running and workersDone < workers do completed.Event:Wait() end
	completed:Destroy()
	return names
end

function F.startPriorityLoading()
	if priorityLoadingActive then return end
	if starPetsCatalogComplete and not valueCatalogLoading then
		loadingState.visible = false
		return
	end
	priorityLoadingActive = true
	loadingStartedAt = os.clock()
	F.setLoadingState("SCANNING SERVER ITEMS...", 0.03)
	task.spawn(function()
		local namesByKey = F.collectServerPriorityNames()
		local names = {}
		for _, displayName in pairs(namesByKey) do table.insert(names, displayName) end
		table.sort(names)

		F.startStarPetsCatalogRefresh()
		F.loadPriorityStarPets(names)
		F.setLoadingState("PRIORITY PRICES READY", 0.88)

		local valueDeadline = os.clock() + CONFIG.HTTP_TIMEOUT_SECONDS + 2
		while running and valueCatalogLoading and os.clock() < valueDeadline do
			F.setLoadingState("FINAL MM2 VALUES CHECK...", 0.94)
			task.wait(0.5)
		end
		priorityLoadingActive = false
		F.finishPriorityLoading("SERVER PRICES READY · FULL CATALOG IN BACKGROUND")
	end)
end

