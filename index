local normaliseCache = {}
local function normalise(value)
	local source = tostring(value or "")
	local cached = normaliseCache[source]
	if cached ~= nil then return cached end
	local result = source:lower():gsub("[%s%p_]", "")
	if #source <= 160 then normaliseCache[source] = result end
	return result
end

