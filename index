function F.isEffectivelyVisible(object, root)
	local node = object
	while node and node ~= root do
		if node:IsA("GuiObject") and not node.Visible then return false end
		node = node.Parent
	end
	return node == root
end

local cachedTradeGui, cachedHeaders = nil, nil
local nextTradeSearch = 0

function F.scanOfferHeaders(gui)
	local headers = {}
	for _, object in ipairs(gui:GetDescendants()) do
		if (object:IsA("TextLabel") or object:IsA("TextButton"))
			and F.isEffectivelyVisible(object, gui) then
			local text = normalise(object.Text)
			local identity = text .. normalise(object.Name)
			if identity:find("youroffer", 1, true)
				or identity:find("theiroffer", 1, true) then
				F.watchVisibility(object, gui)
				table.insert(headers, object)
			end
		end
	end
	table.sort(headers, function(a, b)
		return a.AbsolutePosition.Y < b.AbsolutePosition.Y
	end)
	return headers
end

function F.offerRegions(tradeGui)
	local headers = cachedHeaders
	if not headers or #headers < 2
		or not headers[1]:IsDescendantOf(tradeGui)
		or not headers[2]:IsDescendantOf(tradeGui) then
		headers = F.scanOfferHeaders(tradeGui)
		cachedHeaders = headers
	end

	local regions = {}
	local guiBottom = tradeGui.AbsolutePosition.Y + tradeGui.AbsoluteSize.Y
	for index, header in ipairs(headers) do
		local nextHeader = headers[index + 1]
		local headerText = normalise(header.Text) .. normalise(header.Name)
		table.insert(regions, {
			left = header.AbsolutePosition.X - 8,
			top = header.AbsolutePosition.Y + header.AbsoluteSize.Y,
			bottom = nextHeader and (nextHeader.AbsolutePosition.Y - 1) or guiBottom,
			side = headerText:find("youroffer", 1, true) and "your" or "their",
			header = header,
		})
	end
	return regions
end

function F.offerRegionFor(slot, regions)
	local node = slot
	while node do
		local name = normalise(node.Name)
		if name == "youroffer" or name == "theiroffer" then
			local wanted = name == "youroffer" and "your" or "their"
			for _, region in ipairs(regions) do
				if region.side == wanted then return region end
			end
			break
		end
		node = node.Parent
	end
	local centreX = slot.AbsolutePosition.X + slot.AbsoluteSize.X / 2
	local centreY = slot.AbsolutePosition.Y + slot.AbsoluteSize.Y / 2
	for _, region in ipairs(regions) do
		if centreX >= region.left and centreY >= region.top and centreY <= region.bottom then
			return region
		end
	end
	return nil
end

function F.findTradeGui()
	local function activeTradeGui(tradeGui)
		if not (tradeGui and tradeGui:IsA("ScreenGui") and tradeGui.Enabled) then return nil end
		local container = tradeGui:FindFirstChild("Container")
		if container and container:IsA("GuiObject") and container.Visible then
			local headers = tradeGui == cachedTradeGui and cachedHeaders or nil
			if not headers or #headers < 2
				or not headers[1]:IsDescendantOf(tradeGui)
				or not headers[2]:IsDescendantOf(tradeGui)
				or not F.isEffectivelyVisible(headers[1], tradeGui)
				or not F.isEffectivelyVisible(headers[2], tradeGui) then
				headers = F.scanOfferHeaders(tradeGui)
			end
			if #headers >= 2 then
				cachedTradeGui, cachedHeaders = tradeGui, headers
				return tradeGui
			end
		end
		return nil
	end
	if cachedTradeGui and cachedTradeGui.Parent == playerGui then
		local active = activeTradeGui(cachedTradeGui)
		if active then return active end
	end
	for _, name in ipairs({ "TradeGUI_Phone", "TradeGUI" }) do
		local active = activeTradeGui(playerGui:FindFirstChild(name))
		if active then return active end
	end
	cachedTradeGui, cachedHeaders = nil, nil
	if os.clock() < nextTradeSearch then return nil end
	nextTradeSearch = os.clock() + 0.5
	for _, gui in ipairs(playerGui:GetChildren()) do
		if gui:IsA("ScreenGui") and gui.Enabled and (gui.Name:find("Trade") or gui.Name:find("trade")) then
			local headers = F.scanOfferHeaders(gui)
			if #headers >= 2 then
				cachedTradeGui, cachedHeaders = gui, headers
				return gui
			end
		end
	end
	return nil
end

